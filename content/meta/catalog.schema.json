{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neuromedia public catalog",
  "type": "object",
  "required": ["catalog_version", "locale", "source", "generated_at", "categories", "featured_products"],
  "properties": {
    "catalog_version": {"type": "string"},
    "locale": {"enum": ["ru", "en"]},
    "source": {"type": "string", "pattern": "^https://neuromedia\\.cloud(/|$)"},
    "generated_at": {"type": "string", "format": "date-time"},
    "disclaimer": {"type": "string"},
    "categories": {"type": "array", "items": {"$ref": "#/$defs/category"}},
    "featured_products": {"type": "array", "items": {"$ref": "#/$defs/product"}}
  },
  "$defs": {
    "category": {"type": "object", "required": ["slug", "name", "description"], "properties": {"slug": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "name": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "product": {"type": "object", "required": ["slug", "name", "category", "price_usd", "availability", "delivery", "url", "summary"], "properties": {"slug": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "name": {"type": "string", "minLength": 1}, "category": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "price_usd": {"type": "number", "minimum": 0}, "price_display": {"type": "string"}, "availability": {"enum": ["in_stock", "out_of_stock", "on_request"]}, "delivery": {"enum": ["subscription", "manual", "digital", "service"]}, "url": {"type": "string", "pattern": "^https://neuromedia\\.cloud(/|$)"}, "summary": {"type": "string", "minLength": 1}}}
  }
}
